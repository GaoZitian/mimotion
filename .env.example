# ==========================================
# Zepp Life (原小米运动) 自动刷步数环境变量配置文件模板
# 使用方法：复制本文件重命名为 .env，并填入你的实际配置
# ==========================================

# 1. 账号与密码（必填）
# 支持单个账号，或多个账号用 # 分隔（例如：13800000000#abc@qq.com）
USER=13800000000
PWD=your_password

# 2. 步数随机范围设置（选填，默认 18000 ~ 25000）
MIN_STEP=18000
MAX_STEP=25000

# 3. 本地加密密钥（选填）
# 建议配置 16 位字符串密钥，用于保存和加密 Token 及已绑定设备 ID，加速后续登录
AES_KEY=1234567890123456

# 4. 多账号执行配置（选填）
SLEEP_GAP=5
USE_CONCURRENT=False

# 5. 推送服务通知配置（选填）
# PushPlus 推送配置
PUSH_PLUS_TOKEN=
PUSH_PLUS_HOUR=
PUSH_PLUS_MAX=30

# 企业微信 Webhook 机器人推送配置
PUSH_WECHAT_WEBHOOK_KEY=

# Telegram Bot 推送配置
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# wxpush 微信消息推送配置（选填，https://github.com/frankiejun/wxpush）
# WXPUSH_URL 是 wxpush Worker 基础地址（不含 /wxsend，代码自动拼接），示例：https://your-worker.workers.dev
# WXPUSH_TOKEN 是 wxpush 的 API_TOKEN，示例：your_api_token
# WXPUSH_USERID 可选：覆盖 wxpush 默认接收用户（多个用 | 分隔），示例：OpenID1|OpenID2。不配则用 wxpush 侧的 WX_USERID
# WXPUSH_TEMPLATE_ID 可选：覆盖 wxpush 默认模板，示例：your_template_id。不配则用 wxpush 侧的 WX_TEMPLATE_ID
# WXPUSH_BASE_URL 可选：点击模板消息后的跳转地址，示例：https://your-skin-page.com/skin。不配则跳 wxpush 的 /skin 页
WXPUSH_URL=
WXPUSH_TOKEN=
WXPUSH_USERID=
WXPUSH_TEMPLATE_ID=
WXPUSH_BASE_URL=

# 6. JSON 格式全量配置（选填）
# GitHub Actions 环境中使用的 CONFIG 变量范例
# CONFIG='{"USER": "13800000000", "PWD": "your_password", "MIN_STEP": "18000", "MAX_STEP": "25000", "PUSH_PLUS_TOKEN": "", "PUSH_PLUS_HOUR": "", "PUSH_PLUS_MAX": "30", "PUSH_WECHAT_WEBHOOK_KEY": "", "TELEGRAM_BOT_TOKEN": "", "TELEGRAM_CHAT_ID": "", "WXPUSH_URL": "", "WXPUSH_TOKEN": "", "WXPUSH_USERID": "", "WXPUSH_TEMPLATE_ID": "", "WXPUSH_BASE_URL": "", "SLEEP_GAP": "5", "USE_CONCURRENT": "False"}'
